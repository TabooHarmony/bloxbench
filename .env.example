# LLM API (model being benchmarked)
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=your-api-key

# Judge API (vision model that scores results)
# MUST be an OpenAI-compatible vision model endpoint.
# The judge code uses OpenAI chat completions format with base64 image URLs.
# Anthropic's native API is NOT supported (different headers, different image format).
#
# Recommended: Gemini 2.5 Flash (free tier) via Google's OpenAI-compatible endpoint:
#   JUDGE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#
# Free tier limits (as of July 2026):
#   gemini-2.5-flash:      10 RPM, 250K TPM, 250 RPD
#   gemini-2.5-flash-lite: 15 RPM, 250K TPM, 1,000 RPD
#   gemini-2.5-pro:         5 RPM, 250K TPM, 100 RPD
#
# Use a DIFFERENT model than the one being benchmarked to avoid self-preference bias.
JUDGE_MODEL=gemini-2.5-flash
JUDGE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
JUDGE_API_KEY=your-judge-api-key
